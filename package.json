{
  "name": "figma-plugin-utilities",
  "version": "0.3.1",
  "description": "Shared Svelte components and utilities for Figma plugins",
  "type": "module",
  "svelte": "./src/index.js",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "svelte": "./src/index.js",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./components": {
      "svelte": "./src/components/index.js",
      "import": "./src/components/index.js",
      "default": "./src/components/index.js"
    },
    "./lib": {
      "import": "./src/lib/index.js",
      "default": "./src/lib/index.js"
    },
    "./lib/*": {
      "import": "./src/lib/*.js"
    },
    "./lib/figma-helpers": {
      "types": "./src/lib/figma-helpers.ts",
      "import": "./src/lib/figma-helpers.ts",
      "default": "./src/lib/figma-helpers.ts"
    }
  },
  "files": ["src", "README.md", "LICENSE", "CHANGELOG.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariusroosendaal/figma-plugin-utilities.git"
  },
  "bugs": {
    "url": "https://github.com/mariusroosendaal/figma-plugin-utilities/issues"
  },
  "homepage": "https://github.com/mariusroosendaal/figma-plugin-utilities#readme",
  "keywords": [
    "figma",
    "plugin",
    "svelte",
    "components",
    "utilities",
    "figma-plugin"
  ],
  "author": "Marius Roosendaal",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@figma/plugin-typings": "^1.51.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.2",
    "@types/node": "^22.13.4",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^2.46.0",
    "figma-ui3-kit-svelte": "file:..//_packages/figma-ui3-kit-svelte",
    "globals": "^16.5.0",
    "prettier": "3.7.3",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^4.2.20",
    "svelte-eslint-parser": "^0.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^5.2.0"
  },
  "scripts": {
    "lint": "tsc --noEmit && eslint . --ext .ts,.js,.svelte && npx prettier --check \"src/**/*.{js,ts,svelte,html,css}\"",
    "prettier": "npx prettier --write \"src/**/*.{js,ts,svelte,html,css}\""
  }

}
