{
  "name": "figma-plugin-utilities",
  "version": "0.5.1",
  "description": "Shared Svelte components and utilities for Figma plugins",
  "type": "module",
  "svelte": "./src/index.js",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "svelte": "./src/index.js",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./components": {
      "svelte": "./src/components/index.js",
      "import": "./src/components/index.js",
      "default": "./src/components/index.js"
    },
    "./lib": {
      "import": "./src/lib/index.js",
      "default": "./src/lib/index.js"
    },
    "./lib/*": {
      "import": "./src/lib/*.js"
    },
    "./lib/figma-helpers": {
      "types": "./src/lib/figma-helpers.ts",
      "import": "./src/lib/figma-helpers.ts",
      "default": "./src/lib/figma-helpers.ts"
    },
    "./lib/figma-frame-builders": {
      "types": "./src/lib/figma-frame-builders.ts",
      "import": "./src/lib/figma-frame-builders.ts",
      "default": "./src/lib/figma-frame-builders.ts"
    },
    "./lib/figma-variables": {
      "types": "./src/lib/figma-variables.ts",
      "import": "./src/lib/figma-variables.ts",
      "default": "./src/lib/figma-variables.ts"
    },
    "./lib/colors": {
      "types": "./src/lib/colors.ts",
      "import": "./src/lib/colors.ts",
      "default": "./src/lib/colors.ts"
    },
    "./lib/scale": {
      "types": "./src/lib/scale.ts",
      "import": "./src/lib/scale.ts",
      "default": "./src/lib/scale.ts"
    },
    "./lib/format": {
      "types": "./src/lib/format.ts",
      "import": "./src/lib/format.ts",
      "default": "./src/lib/format.ts"
    },
    "./lib/confirm": {
      "types": "./src/lib/confirm.ts",
      "import": "./src/lib/confirm.ts",
      "default": "./src/lib/confirm.ts"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "import": "./src/vite.js",
      "default": "./src/vite.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariusroosendaal/figma-plugin-utilities.git"
  },
  "bugs": {
    "url": "https://github.com/mariusroosendaal/figma-plugin-utilities/issues"
  },
  "homepage": "https://github.com/mariusroosendaal/figma-plugin-utilities#readme",
  "keywords": [
    "figma",
    "plugin",
    "svelte",
    "components",
    "utilities",
    "figma-plugin"
  ],
  "author": "Marius Roosendaal",
  "license": "MIT",
  "peerDependencies": {
    "figma-ui3-kit-svelte": "^0.7.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.2",
    "vite": "^5.2.0"
  },
  "peerDependenciesMeta": {
    "@sveltejs/vite-plugin-svelte": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@figma/code-connect": "^2.0.1",
    "@figma/plugin-typings": "^1.138.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.2",
    "@types/node": "^22.13.4",
    "eslint": "^9.39.2",
    "eslint-plugin-svelte": "^3.23.0",
    "figma-ui3-kit-svelte": "file:..//_packages/figma-ui3-kit-svelte",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^4.2.20",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.2.0"
  },
  "scripts": {
    "lint": "tsc --noEmit && eslint . --ext .ts,.js,.svelte && npx prettier --check \"src/**/*.{js,ts,svelte,html,css}\"",
    "prettier": "npx prettier --write \"src/**/*.{js,ts,svelte,html,css}\"",
    "figma:parse": "figma connect parse",
    "figma:publish": "figma connect publish"
  }
}
